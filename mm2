<canvas id="rain"></canvas>
<main>

<style>@keyframes b{50%{opacity:0}}@media(prefers-reduced-motion:reduce){span{animation:none!important}}</style>
<p class="hint">Football statistics and probability lab. It runs only in your browser. No live data, no made-up numbers. Tags: <span class="t d">DATA</span> you entered, <span class="t m">MODEL</span> calculated, <span class="t a">ASSUMPTION</span> your choice.</p>
<nav><a id="n_analyzer" href="#analyzer">Match Analyzer</a><a id="n_bets" href="#bets">Bet Calculator</a><a id="n_data" href="#data">Data &amp; Validation</a><a id="n_combo" href="#combo" dir="rtl">محاسبه احتمال فرم ترکیبی</a></nav>

<section id="p_analyzer">
<div class="card"><h2>1. Enter what you know</h2>
<p class="hint">Leave a field empty if you do not know the value. Empty means MISSING. 0 means zero. Missing values are never filled in for you, and events that need them are skipped.</p>
<div class="grid"><div id="fh"></div><div id="fa"></div>
<div><h3>Referee</h3>
<label>Average yellow cards per match<input id="r_y" type="number" min="0" step="any"></label>
<label>Matches officiated<input id="r_n" type="number" min="0" step="1"></label>
<p class="hint">The referee's average is shrunk toward the team-based estimate using a <b>heuristic</b> weight n/(n+10). The 10 is a fixed assumption, not fitted from data. With n = 0 the referee is ignored.</p>
<h3>Your assumptions</h3>
<label>Home goals multiplier (1 = no change)<input id="x_hm" type="number" min="0" step="any"></label>
<label>Away goals multiplier (1 = no change)<input id="x_am" type="number" min="0" step="any"></label>
<label>Number of simulations<input id="x_sims" type="number" min="1000" max="300000" step="1000" value="10000"></label></div></div>
<button id="go">Run analysis</button><div id="msg"></div></div>
<div id="res" hidden></div>
</section>

<section id="p_bets" hidden>
<div class="card"><h2>Bet Calculator</h2>
<p class="hint">Add picks from the Analyzer (they are counted together in the same simulated matches, so dependence is handled) or add your own manual picks. Manual picks are treated as independent, and the result says so.</p>
<button id="addm">+ Add manual selection</button>
<div id="sel"></div>
<label>Stake for the combined bet (optional)<input id="b_st" type="number" min="0" step="any" oninput="calc()"></label>
<div id="sum"></div></div>
</section>

<section id="p_combo" hidden>
<div class="card"><h2><span dir="rtl">محاسبه احتمال فرم ترکیبی</span> <span class="hint">(Combined Bet Form)</span></h2>
<p class="hint">Add every pick of one form. Picks from different matches are treated as independent, so their probabilities are multiplied. Picks from the same match are usually related, so they get a dependency setting below. Everything updates as you type.</p>
<button id="cadd">+ Add selection</button><button id="cex">Load example from your brief</button><button id="cclr">Remove all</button>
<div id="crows"></div><div id="cdep"></div>
<label>Stake (units)<input id="cstake" type="number" min="0" step="any" value="1" oninput="calcCombo()"></label>
<div id="cres"></div><details><summary>Numerical self-tests (copula maths)</summary><button id="ctest">Run self-tests</button><div id="ctres"></div></details></div>
</section>

<section id="p_data" hidden>
<div class="card"><h2>Saved matches (stored only in this browser)</h2>
<p class="hint">CSV columns: date,home,away,hg,ag,hy,ay,hr,ar,hf,af,hc,ac,hst,ast. Dates as YYYY-MM-DD or YYYY/MM/DD. Quoted fields, embedded commas, doubled quotes ("") and multiline quoted fields are supported. Duplicate records (same date+home+away) are dropped. Invalid dates are kept but excluded from time-ordered calculations. Undated records are kept but never used in "last N matches". Format example: 2025-08-16,Team A,Team B,2,1,3,2,0,0,11,13,5,4,4,3</p>
<input type="file" id="file" accept=".csv,text/csv">
<textarea id="csv" rows="6" placeholder="date,home,away,hg,ag,hy,ay,hr,ar,hf,af,hc,ac,hst,ast"></textarea>
<button id="imp">Import (replaces saved matches)</button><button id="exp">Show saved matches as CSV</button><button id="clr">Delete all saved matches</button>
<div id="dmsg"></div><div id="dsum"></div></div>
<div class="card"><h2>Model check (backtest)</h2>
<p class="hint">Chronological split by unique DATE group (not row order). All matches sharing a date belong entirely to either training or testing. The latest training date is strictly earlier than the earliest test date. Records with invalid or missing dates cannot be placed in time and are excluded (and reported).</p>
<button id="bt_go">Run backtest</button><div id="bt"></div></div>
<div class="card"><h2>Data-integrity self-tests</h2>
<p class="hint">Tests for date parsing/sorting, CSV validation, chronological split, and referee shrinkage. These run in your browser.</p>
<details><summary>Run data-integrity self-tests</summary><button id="dt_test">Run tests</button><div id="dt_res"></div></details></div>
</section>
</main>
<script>
const $=id=>document.getElementById(id);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const num=id=>{const v=$(id).value.trim();if(v==='')return null;const x=Number(v);return isFinite(x)&&x>=0?x:NaN};
const f2=(x,d=2)=>x==null||!isFinite(x)?'-':x.toFixed(d),pc=x=>f2(x*100,1)+'%';
const say=(m,c='')=>{$('msg').innerHTML=`<p class="${c}">${m}</p>`};
/* ---------- statistics ---------- */
const sum=a=>a.reduce((s,x)=>s+x,0),mean=a=>sum(a)/a.length;
const vr=a=>{const m=mean(a);return sum(a.map(x=>(x-m)**2))/(a.length-1)};
const med=a=>{const s=[...a].sort((x,y)=>x-y),n=s.length;return n%2?s[(n-1)/2]:(s[n/2-1]+s[n/2])/2};
const rank=a=>{const o=a.map((v,i)=>[v,i]).sort((x,y)=>x[0]-y[0]),r=[];for(let i=0;i<o.length;){let j=i;while(j+1<o.length&&o[j+1][0]===o[i][0])j++;for(let k=i;k<=j;k++)r[o[k][1]]=(i+j)/2+1;i=j+1}return r};
const pear=(x,y)=>{const mx=mean(x),my=mean(y);let a=0,b=0,c=0;x.forEach((v,i)=>{a+=(v-mx)*(y[i]-my);b+=(v-mx)**2;c+=(y[i]-my)**2});return a/Math.sqrt(b*c)};
const spear=(x,y)=>pear(rank(x),rank(y));
const wil=(p,n)=>{const z=1.96,d=1+z*z/n,c=p+z*z/(2*n),h=z*Math.sqrt(p*(1-p)/n+z*z/(4*n*n));return[(c-h)/d,(c+h)/d]};
const t2=(a,b)=>a==null||b==null?null:a+b;
/* ---------- random counts: Poisson and Negative Binomial (gamma-Poisson mixture) ---------- */
function norm(){return Math.sqrt(-2*Math.log(1-Math.random()))*Math.cos(2*Math.PI*Math.random())}
function pois(l){if(!(l>0))return 0;if(l>30)return Math.max(0,Math.round(l+Math.sqrt(l)*norm()));const L=Math.exp(-l);let k=0,p=1;do{k++;p*=Math.random()}while(p>L);return k-1}
function gam(a){if(a<1)return gam(a+1)*Math.pow(Math.random(),1/a);const d=a-1/3,c=1/Math.sqrt(9*d);for(;;){let x,v;do{x=norm();v=1+c*x}while(v<=0);v=v*v*v;const u=Math.random();if(Math.log(u)<.5*x*x+d-d*v+d*Math.log(v))return d*v}}
const cnt=(mu,r)=>mu<=0?0:(isFinite(r)&&r>0?pois(gam(r)*mu/r):pois(mu));
/* ---------- FIX 1: dates ---------- */
function parseDate(s){
 if(typeof s!=='string')return null;
 const t=s.trim(); if(!t)return null;
 let m=/^(\d{4})-(\d{2})-(\d{2})$/.exec(t); if(!m)m=/^(\d{4})\/(\d{1,2})\/(\d{1,2})$/.exec(t);
 if(!m)return null;
 const y=+m[1],mo=+m[2]-1,d=+m[3];
 if(mo<0||mo>11||d<1||d>31)return null;
 const ts=Date.UTC(y,mo,d),chk=new Date(ts);
 if(chk.getUTCFullYear()!==y||chk.getUTCMonth()!==mo||chk.getUTCDate()!==d)return null;
 return ts;
}
const byDateAsc=(a,b)=>{const x=a._ts,y=b._ts;if(x==null&&y==null)return 0;if(x==null)return 1;if(y==null)return -1;return x-y};
/* ---------- FIX 2: CSV parser ---------- */
/* State-machine parser: quoted fields, embedded commas, "" escape, multiline fields, CRLF/LF, UTF-8 BOM.
   Returns {rows:[{cells,line}], malformed:[{line,reason}]}. Never silently drops a row. */
function parseCSVText(text){
 if(typeof text!=='string')return{rows:[],malformed:[]};
 if(text.charCodeAt(0)===0xFEFF)text=text.slice(1);
 const rawRows=[]; const malformed=[];
 let row=[],field='',inQ=false,lineNum=1,rowLineNum=1,i=0;
 while(i<text.length){
  const c=text[i];
  if(inQ){
   if(c==='"'){ if(text[i+1]==='"'){field+='"';i+=2}else{inQ=false;i++} }
   else{if(c==='\n'){lineNum++;rowLineNum=lineNum}field+=c;i++}
  }else{
   if(c==='"'){inQ=true;i++}
   else if(c===','){row.push(field);field='';i++}
   else if(c==='\r'){if(text[i+1]==='\n')i++;row.push(field);rawRows.push({cells:row,line:rowLineNum});row=[];field='';i++;lineNum++;rowLineNum=lineNum}
   else if(c==='\n'){row.push(field);rawRows.push({cells:row,line:rowLineNum});row=[];field='';i++;lineNum++;rowLineNum=lineNum}
   else{field+=c;i++}
  }
 }
 if(inQ)malformed.push({line:rowLineNum,reason:'unmatched quote at end of file'});
 if(field!==''||row.length>0){row.push(field);rawRows.push({cells:row,line:rowLineNum})}
 const rows=rawRows.filter(r=>r.cells.some(f=>f!==''));
 return{rows,malformed};
}
/* ---------- saved matches ---------- */
let H=[];
try{H=JSON.parse(localStorage.getItem('mfl_h')||'[]')}catch(e){H=[]}
H=H.map(r=>({...r,_ts:r.date?parseDate(r.date):null}));
const save=()=>{try{localStorage.setItem('mfl_h',JSON.stringify(H.map(r=>{const{_ts,...rest}=r;return rest})))}catch(e){}};
const COLS=['date','home','away','hg','ag','hy','ay','hr','ar','hf','af','hc','ac','hst','ast'];
const NUMCOLS=['hg','ag','hy','ay','hr','ar','hf','af','hc','ac','hst','ast'];
function importCSV(text){
 const {rows,malformed}=parseCSVText(text);
 if(!rows.length)throw new Error('Empty file');
 const header=rows[0].cells.map(s=>s.trim().toLowerCase());
 const headerLen=header.length;
 // Duplicate headers
 const seenH=new Set(),dupH=[];
 header.forEach(h=>{if(seenH.has(h))dupH.push(h);seenH.add(h)});
 if(dupH.length)throw new Error('Duplicate header columns: '+[...new Set(dupH)].join(', '));
 // Required headers
 const required=['home','away'];
 const missingH=required.filter(k=>!header.includes(k));
 if(missingH.length)throw new Error('Missing required columns: '+missingH.join(', '));
 const report={total:0,imported:0,rejected:0,missingValues:0,invalidNumeric:0,invalidDates:0,duplicates:0,malformedRows:0,reasons:[]};
 malformed.forEach(m=>{report.malformedRows++;report.reasons.push(`Line ${m.line}: ${m.reason}`)});
 const seen=new Set(),records=[];
 for(let r=1;r<rows.length;r++){
  const rowObj=rows[r]; report.total++;
  const row=rowObj.cells;
  if(row.length!==headerLen){
   report.rejected++;
   report.reasons.push(`Line ${rowObj.line}: expected ${headerLen} columns, got ${row.length}`);
   continue;
  }
  const obj={}; header.forEach((k,j)=>{obj[k]=row[j]===''?null:row[j]});
  if(!obj.home||!obj.away){report.rejected++;report.reasons.push(`Line ${rowObj.line}: missing home or away`);continue}
  NUMCOLS.forEach(k=>{
   if(obj[k]==null){report.missingValues++;return}
   const x=Number(obj[k]);
   if(!isFinite(x)||x<0){
     report.invalidNumeric++;
     report.reasons.push(`Line ${rowObj.line}: column ${k}="${obj[k]}" is not a valid non-negative number`);
     obj[k]=null; return;
   }
   obj[k]=x;
  });
  const ts=obj.date?parseDate(obj.date):null;
  if(obj.date&&ts==null){report.invalidDates++;report.reasons.push(`Line ${rowObj.line}: invalid date "${obj.date}"`)}
  obj._ts=ts;
  const key=(obj.date||'')+'|'+obj.home+'|'+obj.away;
  if(seen.has(key)){report.duplicates++;report.reasons.push(`Line ${rowObj.line}: duplicate of ${obj.home} vs ${obj.away} on ${obj.date||'(no date)'}`);continue}
  seen.add(key); records.push(obj); report.imported++;
 }
 report.total+=report.malformedRows;
 records.sort(byDateAsc);
 return {records,report};
}
/* ---------- FIX 3: referee shrinkage (heuristic, fixed k) ---------- */
/* Fixed prior strength. This is a heuristic shrinkage estimator, NOT a fitted Empirical Bayes model:
   the 10-match prior is an assumption, not estimated from within/between-referee variance. */
const REF_PRIOR_K=10;
function refereeWeight(r_n){ if(r_n==null||!(r_n>0))return 0; return r_n/(r_n+REF_PRIOR_K); }
function adjustRef(tot,r_y,r_n){ if(r_y==null)return tot; const w=refereeWeight(r_n); return w*r_y+(1-w)*tot; }
/* ---------- FIX 2b: chronological split (pure, testable) ---------- */
/* R must be sorted by _ts, all _ts non-null. Groups by unique date so no date
   straddles the train/test boundary. */
function chronologicalSplit(R,ratio=0.7){
 if(!R.length)return{tr:[],te:[],trainDates:[],testDates:[],boundary:{trainLast:null,testFirst:null},cannotSplit:true};
 const groups={};
 R.forEach(r=>{const k=String(r._ts);(groups[k]=groups[k]||[]).push(r)});
 const sortedDates=Object.keys(groups).map(Number).sort((a,b)=>a-b);
 if(sortedDates.length<2)return{tr:R,te:[],trainDates:sortedDates,testDates:[],boundary:{trainLast:sortedDates[0]||null,testFirst:null},cannotSplit:true};
 const targetTrain=Math.floor(R.length*ratio);
 let trainCount=0,cutIdx=0;
 for(let i=0;i<sortedDates.length;i++){
   const gsize=groups[sortedDates[i]].length;
   if(trainCount+gsize>targetTrain)break;
   trainCount+=gsize;cutIdx=i+1;
 }
 if(cutIdx===0)cutIdx=1;
 if(cutIdx>=sortedDates.length)cutIdx=Math.max(1,sortedDates.length-1);
 const trainDates=sortedDates.slice(0,cutIdx);
 const testDates=sortedDates.slice(cutIdx);
 const tr=[],te=[];
 trainDates.forEach(d=>tr.push(...groups[d]));
 testDates.forEach(d=>te.push(...groups[d]));
 return{tr,te,trainDates,testDates,boundary:{trainLast:trainDates.length?trainDates[trainDates.length-1]:null,testFirst:testDates.length?testDates[0]:null},cannotSplit:false};
}
/* ---------- FIX 1b: team averages (never include undated) ---------- */
function teamAvg(name,N){
 const all=H.filter(r=>r.home===name||r.away===name);
 const sorted=[...all].sort(byDateAsc);
 const withDate=sorted.filter(r=>r._ts!=null),withoutDate=sorted.filter(r=>r._ts==null);
 const nWant=N>0?N:Infinity;
 const g=withDate.length<=nWant?withDate:withDate.slice(-nWant);
 const f=sel=>{const v=g.map(sel).filter(x=>x!=null);return v.length?{m:mean(v),n:v.length}:null};
 return{gf:f(r=>r.home===name?r.hg:r.ag),ga:f(r=>r.home===name?r.ag:r.hg),y:f(r=>r.home===name?r.hy:r.ay),r:f(r=>r.home===name?r.hr:r.ar),fo:f(r=>r.home===name?r.hf:r.af),c:f(r=>r.home===name?r.hc:r.ac),sot:f(r=>r.home===name?r.hst:r.ast),n:g.length,excludedNoDate:withoutDate.length,totalAll:all.length}}
function disp(fn){const v=H.map(fn).filter(x=>x!=null);
 if(v.length<20)return{r:Infinity,note:`Poisson assumed. Testing for overdispersion needs 20 or more saved matches (you have ${v.length}).`};
 const m=mean(v),s=vr(v);return s>1.15*m?{r:m*m/(s-m),note:`Negative Binomial used: variance ${f2(s)} is above mean ${f2(m)} (n=${v.length}).`}:{r:Infinity,note:`Poisson used: variance ${f2(s)} is close to mean ${f2(m)} (n=${v.length}).`}}
/* ---------- analyzer ---------- */
const F=[['n','Matches in sample'],['gf','Avg goals scored'],['ga','Avg goals conceded'],['y','Avg yellow cards'],['r','Avg red cards'],['f','Avg fouls committed'],['c','Avg corners'],['sot','Avg shots on target']];
const teamForm=(s,t)=>`<h3>${t}</h3><label>Team name<input id="${s}_name"></label>`+F.map(([k,l])=>`<label>${l}<input id="${s}_${k}" type="number" min="0" step="any"></label>`).join('')+`<select id="${s}_N">${Array.from({length:20},(_,i)=>`<option value="${i+1}"${i===4?' selected':''}>Last ${i+1}</option>`).join('')}<option value="999">All saved</option></select><button onclick="fill('${s}')">Load from saved matches</button>`;
$('fh').innerHTML=teamForm('h','Home team');$('fa').innerHTML=teamForm('a','Away team');
function fill(s){const n=$(s+'_name').value.trim(),t=teamAvg(n,+$(s+'_N').value);
 if(!t.n){say(`No dated saved matches for “${esc(n)}”.${t.excludedNoDate?` (${t.excludedNoDate} undated record(s) exist for this team but are excluded.)`:''} The name must match the CSV exactly.`,'warn');return}
 const set=(k,o)=>{$(s+'_'+k).value=o?+o.m.toFixed(2):''};set('gf',t.gf);set('ga',t.ga);set('y',t.y);set('r',t.r);set('f',t.fo);set('c',t.c);set('sot',t.sot);$(s+'_n').value=t.n;
 say(`Loaded ${t.n} dated matches for ${esc(n)} (most recent by date).${t.excludedNoDate?` ${t.excludedNoDate} undated record(s) excluded from the last-N window.`:''}`)}
const DG='Goals scored and conceded by both teams, your multipliers',DC='Team card averages, referee average with heuristic shrinkage, foul count',DR='Red card averages (rarity handled by dispersion / Poisson)',DF='Foul averages of both teams',DCor='Corner averages of both teams';
const E=[
 ['g05','Over 0.5 total goals',s=>s.hg+s.ag>0.5,c=>c.goals,DG],
 ['g15','Over 1.5 total goals',s=>s.hg+s.ag>1.5,c=>c.goals,DG],
 ['g25','Over 2.5 total goals',s=>s.hg+s.ag>2.5,c=>c.goals,DG],
 ['g35','Over 3.5 total goals',s=>s.hg+s.ag>3.5,c=>c.goals,DG],
 ['g45','Over 4.5 total goals',s=>s.hg+s.ag>4.5,c=>c.goals,DG],
 ['hsc','Home team scores',s=>s.hg>0,c=>c.goals,DG],
 ['asc','Away team scores',s=>s.ag>0,c=>c.goals,DG],
 ['bt','Both teams score',s=>s.hg>0&&s.ag>0,c=>c.goals,DG],
 ['hw','Home team wins',s=>s.hg>s.ag,c=>c.goals,DG],
 ['dr','Draw',s=>s.hg===s.ag,c=>c.goals,DG],
 ['aw','Away team wins',s=>s.ag>s.hg,c=>c.goals,DG],
 ['y25','Over 2.5 total yellow cards',s=>s.y>2.5,c=>c.cards,DC],
 ['y35','Over 3.5 total yellow cards',s=>s.y>3.5,c=>c.cards,DC],
 ['y45','Over 4.5 total yellow cards',s=>s.y>4.5,c=>c.cards,DC],
 ['y55','Over 5.5 total yellow cards',s=>s.y>5.5,c=>c.cards,DC],
 ['rr1','At least one red card',s=>s.r>=1,c=>c.reds,DR],
 ['rr2','Two or more red cards',s=>s.r>=2,c=>c.reds,DR],
 ['f205','Over 20.5 total fouls',s=>s.f>20.5,c=>c.fouls,DF],
 ['f225','Over 22.5 total fouls',s=>s.f>22.5,c=>c.fouls,DF],
 ['f245','Over 24.5 total fouls',s=>s.f>24.5,c=>c.fouls,DF],
